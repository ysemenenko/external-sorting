<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>

    <!-- NuGet package metadata -->
    <PackageId>ExternalSorting.Core</PackageId>
    <Version>1.0.6</Version>
    <Authors>Yaroslav Semenenko</Authors>
    <Description>K-way external merge sort for .NET 8. Sort datasets larger than available memory using parallel chunk sorting and binary min-heap merge. v1.0.6 shares one estimated item-memory budget across a bounded pool of reusable chunk buffers, with cancellation-aware waits and worker cleanup on failure. Includes parallel multi-pass merge, Knuth's Replacement Selection, Int64 record counts and sort metrics. Generic IExternalSorter&lt;T&gt; — plug in any record type, comparer, and serializer.</Description>
    <PackageReleaseNotes>1.0.6: MaxMemoryBytes is now a global estimated item-memory budget for chunk creation. Parallel sorting uses bounded reusable buffers; cancellation and failures drain workers before cleanup. Public API and binary format are unchanged. See CHANGELOG.md for budget exclusions and compatibility details.</PackageReleaseNotes>
    <PackageTags>external-sort;merge-sort;k-way-merge;large-file;disk-sort;out-of-core;sorting</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://ysemenenko.github.io/external-sorting/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ysemenenko/external-sorting.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
